if(NOT DEFINED CLI OR NOT DEFINED SCENARIOS)
    message(FATAL_ERROR "CLI and SCENARIOS paths are required")
endif()

function(check_cli expected_code expected_status expected_cost)
    execute_process(COMMAND "${CLI}" ${ARGN}
        RESULT_VARIABLE actual_code OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 20)
    if(NOT "${actual_code}" STREQUAL "${expected_code}")
        message(FATAL_ERROR "Expected exit ${expected_code}, got ${actual_code}: ${output} ${errors}")
    endif()
    string(JSON status ERROR_VARIABLE json_error GET "${output}" status)
    if(json_error OR NOT status STREQUAL expected_status)
        message(FATAL_ERROR "Invalid JSON/status: ${output}; ${json_error}")
    endif()
    if(NOT expected_cost STREQUAL "skip")
        string(JSON cost GET "${output}" cost)
        if(NOT cost STREQUAL expected_cost)
            message(FATAL_ERROR "Expected cost ${expected_cost}, got ${cost}: ${output}")
        endif()
        string(JSON cost_type TYPE "${output}" cost)
        if(NOT cost_type STREQUAL "STRING")
            message(FATAL_ERROR "Costs must preserve their integer precision as JSON strings")
        endif()
    endif()
endfunction()

check_cli(0 success 6000 "${SCENARIOS}/weighted-detour.maze.txt" --algorithm astar)
check_cli(0 success 6000 "${SCENARIOS}/weighted-detour.maze.txt" --algorithm dijkstra)
check_cli(0 success 5000 "${SCENARIOS}/corridor.maze.txt" --algorithm bfs)
check_cli(3 no_path skip "${SCENARIOS}/no-path.maze.txt")
check_cli(2 unsupported_configuration skip "${SCENARIOS}/weighted-detour.maze.txt" --algorithm bfs)
check_cli(4 resource_limit skip "${SCENARIOS}/corridor.maze.txt" --max-expansions 1)
check_cli(2 invalid_request skip "${SCENARIOS}/corridor.maze.txt" --algorithm missing)
check_cli(2 invalid_request skip "${SCENARIOS}/corridor.maze.txt" --max-expansions -1)
check_cli(2 invalid_request skip "${SCENARIOS}/corridor.maze.txt" --allow-corner-cutting)
check_cli(2 invalid_request skip "${SCENARIOS}/not-a-map.maze.txt")
check_cli(3 no_path skip "${SCENARIOS}/blocked-corner.maze.txt" --diagonal)
check_cli(0 success 1414 "${SCENARIOS}/blocked-corner.maze.txt" --diagonal --allow-corner-cutting)
