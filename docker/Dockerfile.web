# syntax=docker/dockerfile:1
FROM emscripten/emsdk:6.0.10 AS wasm
WORKDIR /src
COPY CMakeLists.txt ./
COPY core/ ./core/
COPY bindings/ ./bindings/
RUN emcmake cmake -S . -B /build -DCMAKE_BUILD_TYPE=Release \
        -DMAZE_BUILD_WASM=ON -DMAZE_BUILD_LEGACY=OFF -DMAZE_BUILD_CLI=OFF -DBUILD_TESTING=OFF \
    && cmake --build /build --parallel 2 \
    && cmake --install /build --prefix /out

FROM scratch AS wasm-artifacts
COPY --from=wasm /out/ /

FROM node:22.20.0-bookworm-slim AS client
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/web/ ./
COPY --from=wasm /out/engine/ ./public/engine/
RUN node --test tests/model.test.mjs tests/comparison.test.mjs && npm run build

FROM node:22.20.0-bookworm-slim AS runtime
ENV NODE_ENV=production PORT=8080
WORKDIR /app
COPY --from=client --chown=node:node /app/dist/ ./dist/
COPY --chown=node:node apps/web/server.mjs ./server.mjs
USER node
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=4s --start-period=10s --retries=3 \
    CMD ["node", "--input-type=module", "-e", "const r = await fetch('http://127.0.0.1:8080/health'); if (!r.ok) process.exit(1)"]
CMD ["node", "server.mjs"]
